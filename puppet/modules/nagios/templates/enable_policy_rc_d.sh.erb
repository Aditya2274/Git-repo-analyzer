#!/bin/sh
set -eu

POLICY_FILE="<%= @policy_file %>"
PID_FILE="<%= @pid_file %>"
MARKER="<%= @marker %>"
SUPPRESSED_SERVICES="<%= @suppressed_services.join(' ') %>"

verify_admin_policy() {
  if [ -L "${POLICY_FILE}" ] && [ ! -e "${POLICY_FILE}" ]; then
    echo "ERROR: Existing administrator-managed policy '${POLICY_FILE}' is a broken symlink; cannot guarantee startup suppression for Nagios Core or Apache2. Operator must inspect and resolve '${POLICY_FILE}' before installation." >&2
    return 1
  fi

  if [ ! -f "${POLICY_FILE}" ]; then
    echo "ERROR: Existing administrator-managed policy '${POLICY_FILE}' is not a regular file; behavior cannot be reliably determined. Operator must resolve '${POLICY_FILE}' before installation." >&2
    return 1
  fi

  if [ ! -r "${POLICY_FILE}" ] || [ ! -x "${POLICY_FILE}" ]; then
    echo "ERROR: Existing administrator-managed policy '${POLICY_FILE}' is not both readable and executable (invoke-rc.d/deb-systemd-invoke ignore non-executable policies and would start services). Operator must fix permissions or resolve '${POLICY_FILE}' before installation." >&2
    return 1
  fi

  for svc in ${SUPPRESSED_SERVICES}; do
    for pass in 1 2; do
      for mode in unit_start service_start paren_start paren_start_rl2 unit_restart service_restart; do
        case "${mode}" in
          unit_start)
            probe_unit="${svc}"; probe_act="start"; probe_rl="" ;;
          service_start)
            probe_unit="${svc}.service"; probe_act="start"; probe_rl="" ;;
          paren_start)
            probe_unit="${svc}"; probe_act="(start)"; probe_rl="" ;;
          paren_start_rl2)
            probe_unit="${svc}"; probe_act="(start)"; probe_rl="2" ;;
          unit_restart)
            probe_unit="${svc}.service"; probe_act="restart"; probe_rl="" ;;
          service_restart)
            probe_unit="${svc}"; probe_act="(restart)"; probe_rl="" ;;
        esac

        rc=0
        if [ -n "${probe_rl}" ]; then
          /usr/bin/timeout 3 /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin \
            "${POLICY_FILE}" "${probe_unit}" "${probe_act}" "${probe_rl}" < /dev/null >/dev/null 2>&1 || rc=$?
        else
          /usr/bin/timeout 3 /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin \
            "${POLICY_FILE}" "${probe_unit}" "${probe_act}" < /dev/null >/dev/null 2>&1 || rc=$?
        fi

        if [ "${rc}" -eq 0 ] || [ "${rc}" -eq 104 ]; then
          echo "ERROR: Existing administrator-managed policy '${POLICY_FILE}' PERMITS premature startup/restart for '${svc}' (probe '${probe_unit} ${probe_act}' exited ${rc}, expected 101). Refusing to install Nagios/Apache packages. Operator must adjust or remove '${POLICY_FILE}' before installation." >&2
          return 1
        elif [ "${rc}" -eq 124 ]; then
          echo "ERROR: Existing administrator-managed policy '${POLICY_FILE}' timed out probing '${probe_unit} ${probe_act}'; behavior cannot be reliably determined. Operator must resolve '${POLICY_FILE}' before installation." >&2
          return 1
        elif [ "${rc}" -ne 101 ]; then
          echo "ERROR: Existing administrator-managed policy '${POLICY_FILE}' behavior cannot be reliably determined for '${svc}' (probe '${probe_unit} ${probe_act}' exited ambiguous/non-101 status ${rc}). Operator must resolve '${POLICY_FILE}' before installation." >&2
          return 1
        fi
      done
    done
  done

  return 0
}

# Inspect any pre-existing policy-rc.d before touching anything or installing packages.
if [ -e "${POLICY_FILE}" ] || [ -L "${POLICY_FILE}" ]; then
  if [ -f "${POLICY_FILE}" ] && [ ! -L "${POLICY_FILE}" ] && /usr/bin/grep -qF "# ${MARKER}" "${POLICY_FILE}" 2>/dev/null; then
    # Existing Puppet-managed temporary policy: check recorded Puppet process lifecycle
    if [ -f "${PID_FILE}" ]; then
      EXISTING_PID="$(/usr/bin/cat "${PID_FILE}" 2>/dev/null || true)"
      if [ -n "${EXISTING_PID}" ] && [ "${EXISTING_PID}" != "${PPID}" ] && kill -0 "${EXISTING_PID}" 2>/dev/null; then
        if [ -r "/proc/${EXISTING_PID}/cmdline" ] && /usr/bin/tr '\0' ' ' < "/proc/${EXISTING_PID}/cmdline" | /usr/bin/grep -q 'puppet'; then
          echo "ERROR: Concurrent active Puppet process (PID ${EXISTING_PID}) currently holds Nagios install guard '${POLICY_FILE}'. Wait for that run to finish before retrying." >&2
          exit 1
        fi
      fi
    fi
    # Stale/dead PID or current process: fall through to refresh PID and scoped Puppet policy cleanly.
  else
    # Administrator-managed policy: verify safely without modifying, overwriting, or deleting it.
    verify_admin_policy
    exit 0
  fi
fi

# Record active parent Puppet process PID so policy-rc.d fails open automatically
# (exiting 0) if Puppet aborts before cleanup executes.
/bin/echo "${PPID}" > "${PID_FILE}"

TMP_POLICY="${POLICY_FILE}.puppet-tmp.$$"
/usr/bin/cat <<'POLICY_EOF' > "${TMP_POLICY}"
#!/bin/sh
# <%= @marker %>
# Narrowly scoped temporary startup guard for Ubuntu 24.04 package installation.
# Suppresses maintainer-script service starts ONLY for Nagios Core and Apache2
# while the active Puppet installation process PID is alive. Returns 0 (allow)
# for all unrelated services or if Puppet has already exited.

SERVICE="${1%.service}"
PID_FILE="<%= @pid_file %>"

case "${SERVICE}" in
  <%= @suppressed_services.join('|') %>)
    if [ -f "${PID_FILE}" ]; then
      GUARD_PID="$(/usr/bin/cat "${PID_FILE}" 2>/dev/null || true)"
      if [ -n "${GUARD_PID}" ] && kill -0 "${GUARD_PID}" 2>/dev/null; then
        if [ -r "/proc/${GUARD_PID}/cmdline" ] && /usr/bin/tr '\0' ' ' < "/proc/${GUARD_PID}/cmdline" | /usr/bin/grep -q 'puppet'; then
          exit 101
        fi
      fi
    fi
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
POLICY_EOF

/usr/bin/chmod 0755 "${TMP_POLICY}"
/usr/bin/mv -f "${TMP_POLICY}" "${POLICY_FILE}"
