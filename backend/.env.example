# Runtime configuration for Express Backend (Checkpoint 6.1 Contract)
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
DATA_DIR=./data

# Optional comma-separated allowed CORS origins (leave empty in production same-origin NGINX setup)
CORS_ORIGIN=http://localhost:5173

# Security guards (must stay true in production)
SSRF_CHECK_DNS=true
ANALYSIS_TIMEOUT_MS=600000

# Jenkins integration settings (consumed in Checkpoint 6.2 / Phase 7; mock mode default in dev/staging)
JENKINS_MOCK_MODE=true
JENKINS_URL=
JENKINS_USER=
JENKINS_API_TOKEN=
JENKINS_JOB_NAME=git-repo-analyzer
